{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "src/main.ts",
      "methods": ["HEAD", "GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    }
  ]
}
